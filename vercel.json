{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd aetheria && npm install",
  "buildCommand": "cd aetheria && npm run build --workspace shared && npm run build --workspace client",
  "outputDirectory": "aetheria/client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
