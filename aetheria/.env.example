# Required for GenAI Oracle, Routine Generation, Vision Scan, Translations, Tutorial Q&A, and STT/TTS fallback
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model name (default: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Optional (recommended for Indian/Asian station-level AQI): https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# Optional (recommended for walking route alternatives): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Optional (for Web Push alerts; generate via `npm run gen:vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sanctuary@aetheria.local

# Optional Server Configuration
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data.db
EMERGENCY_NUMBER=112
